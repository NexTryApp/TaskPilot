# TaskPilot Environment Variables
# Copy this file to .env and fill in your values

# --- LLM Provider (configured in UI, but can also be set here) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: Docker Sandbox for terminal commands ---
# SANDBOX_URL=http://localhost:4243

# --- Optional: Override default port (default: 4242) ---
# PORT=4242
