# TaskPilot Sandbox — isolated command execution container
FROM node:22-slim

# Install useful CLI tools available to the agent
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    python3 \
    python3-pip \
    jq \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY sandbox/package.json sandbox/package-lock.json* ./
RUN npm install && npm cache clean --force

# Install tsx globally
RUN npm install -g tsx

# Copy sandbox source
COPY sandbox/server.ts sandbox/tsconfig.json ./

# Create data directory (shared volume mount point)
RUN mkdir -p /app/data

EXPOSE 3001

ENV NODE_ENV=production

CMD ["tsx", "server.ts"]
